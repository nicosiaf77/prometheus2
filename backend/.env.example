APP_NAME=Prometheus2
APP_ENV=local
APP_DEBUG=true
APP_KEY=genera-con-php-r-echo-bin2hex-random-bytes-32
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=prometheus2
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=prometheus2_session
SESSION_SAMESITE=Lax

# Percorso assoluto di mysqldump o mariadb-dump. Lascia vuoto per rilevazione automatica da PATH.
BACKUP_DUMP_COMMAND=

# Cifratura backup: impostare true per cifrare i file .sql con AES-256-CBC tramite openssl.
# La chiave usata e APP_KEY. Richiede openssl installato nel PATH.
BACKUP_ENCRYPT=false
