{
  "name": "nicosiaf77/prometheus2",
  "description": "Framework PHP Prometheus2 per registro elettronico controlli amministrativi.",
  "type": "project",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Prometheus\\": "app/"
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:8080 -t public public/router.php",
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php",
    "create-admin": "php scripts/create_admin.php",
    "test:smoke": "php tests/smoke.php",
    "test:roles": "php tests/roles.php"
  }
}
